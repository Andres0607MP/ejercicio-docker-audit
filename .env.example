# ============================================================
# Variables de entorno — EJEMPLO
# ============================================================
# Este archivo es una PLANTILLA. No contiene secretos reales.
# Copia como .env en la EC2 y reemplaza los valores placeholder.
#
# IMPORTANTE: Nunca commitees .env. Siempre debe estar en .gitignore.
# ============================================================

# ──────────────────────────────────────────────────────────
# Base de datos (MySQL)
# ──────────────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=appuser
DB_PASS=change_me_in_ec2
DB_NAME=legacydb

# ──────────────────────────────────────────────────────────
# MySQL root password (solo para Docker)
# ──────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_in_ec2

# ──────────────────────────────────────────────────────────
# Docker Hub (etiqueta de la imagen a desplegar)
# ──────────────────────────────────────────────────────────
# Se usa en docker-compose.prod.yml como:
#   image: andresmancera/mi-api:${IMAGE_TAG:-latest}
# Durante CI/CD, GitHub Actions pasa IMAGE_TAG=<commit-sha>
# Para rollback, override con:
#   docker compose -f docker-compose.prod.yml up -d IMAGE_TAG=<sha-anterior>
IMAGE_TAG=latest
